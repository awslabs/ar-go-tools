{
  "rq": "checker-ablation",
  "repo": "prometheus",
  "targets": [
    {
      "summary_name": "(*net/http.conn).serve",
      "kind": "function",
      "results": [
        {
          "name": "(*net/http.conn).serve",
          "checker_method": "immutability"
        }
      ]
    },
    {
      "summary_name": "(*net/http.http2serverConn).serve",
      "kind": "function",
      "results": [
        {
          "name": "(*net/http.http2serverConn).serve",
          "checker_method": "immutability"
        }
      ]
    },
    {
      "summary_name": "net/http.Handle",
      "kind": "function",
      "results": [
        {
          "name": "net/http.Handle",
          "checker_method": "immutability"
        }
      ]
    },
    {
      "summary_name": "net/http.HandleFunc",
      "kind": "function",
      "results": [
        {
          "name": "net/http.HandleFunc",
          "checker_method": "immutability"
        }
      ]
    },
    {
      "summary_name": "net/http.ListenAndServe",
      "kind": "function",
      "results": [
        {
          "name": "net/http.ListenAndServe",
          "checker_method": "read"
        }
      ]
    },
    {
      "summary_name": "net/http.NotFound",
      "kind": "function",
      "results": [
        {
          "name": "net/http.NotFound",
          "checker_method": "immutability"
        }
      ]
    },
    {
      "summary_name": "net/http.StatusText",
      "kind": "function",
      "results": [
        {
          "name": "net/http.StatusText",
          "checker_method": "general"
        }
      ]
    }
  ]
}