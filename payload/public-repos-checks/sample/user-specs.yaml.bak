dataflow-summaries:
  # encoding/hex.EncodeToString converts byte slice to hex string
  - package: "encoding/hex"
    function: "EncodeToString"
    flows:
      - from: "(!arg 0)[*]"
        to: "!ret 0"
  
  # crypto/x509.ParseECPrivateKey parses EC private key from bytes
  - package: "crypto/x509"
    function: "ParseECPrivateKey"
    flows:
      - from: "(!arg 0)[*]"
        to: "!ret 0"
      - from: "(!arg 0)[*]"
        to: "!ret 1"
  
  # crypto/cipher.NewGCM creates GCM cipher from block cipher
  - package: "crypto/cipher"
    function: "NewGCM"
    flows:
      - from: "!arg 0"
        to: "!ret 0"
      - from: "!arg 0"
        to: "!ret 1"
  
  # crypto/aes.NewCipher creates AES cipher from key
  - package: "crypto/aes"
    function: "NewCipher"
    flows:
      - from: "(!arg 0)[*]"
        to: "!ret 0"
      - from: "(!arg 0)[*]"
        to: "!ret 1"
  
  # encoding/hex.DecodeString decodes hex string to bytes
  - package: "encoding/hex"
    function: "DecodeString"
    flows:
      - from: "!arg 0"
        to: "(!ret 0)[*]"
      - from: "!arg 0"
        to: "!ret 1"
  
  # strings.TrimSpace removes leading/trailing whitespace
  - package: "strings"
    function: "TrimSpace"
    flows:
      - from: "!arg 0"
        to: "!ret 0"
  
  # io/ioutil.ReadFile reads file contents
  - package: "io/ioutil"
    function: "ReadFile"
    flows:
      - from: "!arg 0"
        to: "(!ret 0)[*]"
      - from: "!arg 0"
        to: "!ret 1"
  
  # github.com/aws/aws-sdk-go/aws.String converts string to *string
  - package: "github.com/aws/aws-sdk-go/aws"
    function: "String"
    flows:
      - from: "!arg 0"
        to: "!ret 0"
  
  # P224Element.Square squares field element (modifies receiver)
  - package: "crypto/internal/fips140/nistec/fiat"
    receiver: "*P224Element"
    method: "Square"
    flows:
      - from: "(!arg 0).x"
        to: "(!receiver).x"
      - from: "!receiver"
        to: "!ret 0"
  
  # P384Element.Square squares field element (modifies receiver)
  - package: "crypto/internal/fips140/nistec/fiat"
    receiver: "*P384Element"
    method: "Square"
    flows:
      - from: "(!arg 0).x"
        to: "(!receiver).x"
      - from: "!receiver"
        to: "!ret 0"
  
  # P521Element.Square squares field element (modifies receiver)
  - package: "crypto/internal/fips140/nistec/fiat"
    receiver: "*P521Element"
    method: "Square"
    flows:
      - from: "(!arg 0).x"
        to: "(!receiver).x"
      - from: "!receiver"
        to: "!ret 0"
  
  # fmt.Stringer.String interface method
  - package: "fmt"
    interface: "Stringer"
    method: "String"
    flows:
      - from: "!receiver"
        to: "!ret 0"
  
  # github.com/aws/aws-sdk-go/private/protocol/rest.Build builds REST request
  - package: "github.com/aws/aws-sdk-go/private/protocol/rest"
    function: "Build"
    flows:
      - from: "(!arg 0).Params"
        to: "(!arg 0).HTTPRequest"
      - from: "(!arg 0).Params"
        to: "!arg 0"
  
  # crypto/elliptic.MarshalCompressed marshals elliptic curve point
  - package: "crypto/elliptic"
    function: "MarshalCompressed"
    flows:
      - from: "!arg 0"
        to: "(!ret 0)[*]"
      - from: "!arg 1"
        to: "(!ret 0)[*]"
      - from: "!arg 2"
        to: "(!ret 0)[*]"
  
  # crypto/elliptic.GenerateKey generates elliptic curve key pair
  - package: "crypto/elliptic"
    function: "GenerateKey"
    flows:
      - from: "!arg 0"
        to: "(!ret 0)[*]"
      - from: "!arg 0"
        to: "!ret 1"
      - from: "!arg 0"
        to: "!ret 2"
      - from: "!arg 0"
        to: "!ret 3"
      - from: "!arg 1"
        to: "(!ret 0)[*]"
      - from: "!arg 1"
        to: "!ret 1"
      - from: "!arg 1"
        to: "!ret 2"
      - from: "!arg 1"
        to: "!ret 3"
  
  # encoding/base64.Encoding.EncodeToString encodes bytes to base64 string
  - package: "encoding/base64"
    receiver: "*Encoding"
    method: "EncodeToString"
    flows:
      - from: "!receiver"
        to: "!ret 0"
      - from: "(!arg 0)[*]"
        to: "!ret 0"
  
  # crypto/internal/fips140/hmac.HMAC.Sum computes HMAC
  - package: "crypto/internal/fips140/hmac"
    receiver: "*HMAC"
    method: "Sum"
    flows:
      - from: "!receiver"
        to: "(!ret 0)[*]"
      - from: "(!arg 0)[*]"
        to: "(!ret 0)[*]"
  
  # crypto/ecdsa.PrivateKey.Sign signs digest with ECDSA
  - package: "crypto/ecdsa"
    receiver: "*PrivateKey"
    method: "Sign"
    flows:
      - from: "!receiver"
        to: "(!ret 0)[*]"
      - from: "!receiver"
        to: "!ret 1"
      - from: "!arg 0"
        to: "(!ret 0)[*]"
      - from: "!arg 0"
        to: "!ret 1"
      - from: "(!arg 1)[*]"
        to: "(!ret 0)[*]"
      - from: "(!arg 1)[*]"
        to: "!ret 1"
      - from: "!arg 2"
        to: "(!ret 0)[*]"
      - from: "!arg 2"
        to: "!ret 1"
